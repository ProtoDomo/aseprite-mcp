test/
tests/
__tests__/
jest.config.js
*.test.js

# Development files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# TypeScript
tsconfig.json
tsconfig.*.json
*.tsbuildinfo

# Package manager
.npmrc
npm-debug.log
npm-error.log
yarn-error.log
pnpm-debug.log

# Miscellaneous
.editorconfig
.prettierrc
.eslintrc*
.github/
